{
  "name": "delinote",
  "version": "0.9.4",
  "description": "DéliNote — local-first note-taking app with notes, calendar, tasks, attachments, and medication tracking. 100% offline, no telemetry.",
  "main": "out/main/index.js",
  "author": {
    "name": "DéliNote",
    "email": "noreply@delinote.local"
  },
  "homepage": "https://delinote.local",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icon": "node scripts/build-icon.mjs",
    "package": "npm run icon && electron-vite build && electron-builder --dir",
    "dist": "npm run icon && electron-vite build && electron-builder",
    "dist:portable": "npm run icon && electron-vite build && electron-builder --win zip",
    "dist:publish": "npm run icon && electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@tiptap/extension-character-count": "^2.6.6",
    "@tiptap/extension-code-block-lowlight": "^2.6.6",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.6.6",
    "@tiptap/extension-table-cell": "^2.6.6",
    "@tiptap/extension-table-header": "^2.6.6",
    "@tiptap/extension-table-row": "^2.6.6",
    "@tiptap/extension-task-item": "^2.6.6",
    "@tiptap/extension-task-list": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-typography": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/html": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@xenova/transformers": "^2.17.2",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^4.5.0",
    "fuse.js": "^7.0.0",
    "katex": "^0.16.11",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.4.0",
    "nanoid": "^5.0.7",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "turndown": "^7.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.delinote.app",
    "productName": "DeliNote",
    "copyright": "Copyright © 2026 DéliNote — Local-first notes",
    "publish": [
      {
        "provider": "github",
        "owner": "Jordan-Bourillot",
        "repo": "delinote",
        "private": false,
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/public/lion.png",
        "to": "lion.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "publisherName": "DéliNote",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "sign": null
      },
      "fileAssociations": []
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "DéliNote",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "warningsAsErrors": false
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
